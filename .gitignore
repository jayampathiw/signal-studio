# Environment
.env
.env.local

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.next/
apps/dashboard/dist/
apps/dashboard/.angular/

# Render caches & outputs
output/
/tmp/documentary/
/tmp/reels/
**/.remotion/
temp/
productions/

# Supabase CLI local cache
supabase/.temp/

# Python
__pycache__/
*.pyc
*.pyo

# Piper TTS voice models (downloaded, not committed)
packages/media/piper-voices/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Eval traces (generated, not committed)
evals/traces/
evals/scorecards/

# Audio kit binaries (manifest committed, media files are not)
content/audio-kit/*
!content/audio-kit/manifest.json
!content/audio-kit/SOURCES.md

# Logs
*.log
npm-debug.log*

# Longform generated images (large binaries — not committed, uploaded to R2)
content/longform/*/stills/
content/longform/*/refs/
.vercel

# Shorts image-validation scratch copies (duplicates of longform stills, for manual review only)
content/shorts/_review/

# Shorts rendered output + generated assets — not tracked, same convention as
# content/longform/*/stills (binaries, regenerable from configs + source stills)
content/shorts/*/src/*.mp4
content/shorts/*/vertical-assets/
content/shorts/*/vo-overrides/
content/shorts/_final-review/

# AssembleX pilot bridge (P0.8) — generated media, regenerable from pack.json
projects/**/clips/
projects/**/vo/
projects/**/out/
projects/**/qa/
projects/**/stills/
projects/**/refs/
projects/assemblex-factory/pilot/public/staged/
