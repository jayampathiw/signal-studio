{
  "$ref": "#/definitions/manifest.v1",
  "definitions": {
    "manifest.v1": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1"
        },
        "projectRef": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "properties": {
            "jobs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string"
                  }
                },
                "required": ["kind", "ref"],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "jobs": []
          }
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "clip": {
                "type": "string"
              },
              "source": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "page": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "highlight": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string",
                              "minLength": 1
                            },
                            "context": {
                              "type": "string",
                              "minLength": 1
                            },
                            "occurrence": {
                              "type": "integer",
                              "exclusiveMinimum": 0
                            },
                            "fromSec": {
                              "type": "number"
                            },
                            "toSec": {
                              "type": "number"
                            },
                            "fromFraction": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "toFraction": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "opacity": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": ["text"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": ["url"],
                "additionalProperties": false
              },
              "trim_in_s": {
                "type": "number",
                "minimum": 0,
                "default": 0
              },
              "speed": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4,
                "default": 1
              },
              "overlay_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "overlay_in_s": {
                "type": "number",
                "minimum": 0,
                "default": 0.4
              },
              "overlay_out_s": {
                "type": "number",
                "minimum": 0
              },
              "voiceover_text": {
                "type": "string",
                "minLength": 1
              },
              "ig_optional": {
                "type": "boolean",
                "default": false
              },
              "audio": {
                "type": "object",
                "properties": {
                  "strip_native_audio": {
                    "type": "boolean",
                    "default": false
                  },
                  "keep_native_sfx": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "additionalProperties": false,
                "default": {
                  "strip_native_audio": false,
                  "keep_native_sfx": true
                }
              },
              "fact_confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "verify": {
                "type": "string"
              },
              "highlight": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "fromSec": {
                    "type": "number"
                  },
                  "toSec": {
                    "type": "number"
                  },
                  "fromFraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "toFraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["x", "y", "width", "height"],
                "additionalProperties": false
              },
              "highlights": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/manifest.v1/properties/shots/items/properties/highlight"
                }
              },
              "zoomFrom": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["x", "y", "width", "height"],
                "additionalProperties": false
              },
              "zoomTo": {
                "$ref": "#/definitions/manifest.v1/properties/shots/items/properties/zoomFrom"
              },
              "holdExtraSecs": {
                "type": "number"
              },
              "waveformOverlay": {
                "type": "boolean"
              },
              "durationSecs": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "visual": {
                "type": "object",
                "additionalProperties": {}
              },
              "episodeRef": {
                "type": "string"
              }
            },
            "required": ["id"],
            "additionalProperties": false
          },
          "default": []
        },
        "visual": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string"
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        "audio": {
          "type": "object",
          "properties": {
            "voice": {
              "type": "string",
              "minLength": 1
            },
            "speed": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "music": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["auto", "none", "in-app"],
                  "default": "auto"
                },
                "file": {
                  "type": "string"
                },
                "mood": {
                  "type": "string"
                },
                "gain_db": {
                  "type": "number",
                  "default": -18
                },
                "bed_lufs": {
                  "type": "number",
                  "maximum": -6,
                  "default": -24
                },
                "duck": {
                  "type": "boolean",
                  "default": true
                }
              },
              "additionalProperties": false,
              "default": {
                "mode": "auto",
                "gain_db": -18,
                "bed_lufs": -24,
                "duck": true
              }
            }
          },
          "additionalProperties": false,
          "default": {
            "music": {
              "mode": "auto",
              "gain_db": -18,
              "bed_lufs": -24,
              "duck": true
            }
          }
        },
        "end_card": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "disclosure": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["subject", "disclosure"],
          "additionalProperties": false
        },
        "watermark": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "default": "AI visualisation"
            }
          },
          "additionalProperties": false,
          "default": {
            "text": "AI visualisation"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "captions": {
          "type": "object",
          "properties": {
            "facebook": {
              "type": "string"
            },
            "facebook_question": {
              "type": "string"
            },
            "instagram": {
              "type": "string"
            },
            "youtube_shorts_title": {
              "type": "string"
            },
            "youtube_description": {
              "type": "string"
            },
            "youtube_tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "hashtags_facebook": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "hashtags_instagram": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "disclosure": {
          "type": "boolean",
          "default": true
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "publish": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "compilationTargetS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "case_file": {
          "type": "object",
          "properties": {
            "caseId": {
              "type": "string",
              "minLength": 1
            },
            "aspectRatio": {
              "type": "string",
              "enum": ["16:9", "9:16"],
              "default": "16:9"
            },
            "sourceCitation": {
              "type": "string"
            },
            "hideSourceOnScreen": {
              "type": "boolean",
              "default": false
            },
            "specimen": {
              "type": "boolean",
              "default": false
            },
            "showOutro": {
              "type": "boolean",
              "default": true
            }
          },
          "required": ["caseId"],
          "additionalProperties": false
        },
        "stillsKenburns": {
          "type": "object",
          "properties": {
            "shotlistText": {
              "type": "string",
              "minLength": 1
            },
            "stillImages": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "aspectRatio": {
              "type": "string",
              "enum": ["16:9", "9:16"],
              "default": "16:9"
            }
          },
          "required": ["shotlistText", "stillImages"],
          "additionalProperties": false
        },
        "shorts916": {
          "type": "object",
          "properties": {
            "output": {
              "type": "string",
              "minLength": 1
            },
            "voice": {
              "type": "string"
            },
            "images": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "default": {}
            },
            "scenes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "image2": {
                    "type": "string"
                  },
                  "motion": {
                    "type": "string"
                  },
                  "motion2": {
                    "type": "string"
                  },
                  "regrade": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["warm_amber", "cold_blue"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "regrade2": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": ["warm_amber", "cold_blue"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "crop_x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "crop_x2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "vo": {
                    "type": "string"
                  },
                  "vo_parts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "pause_sec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "target_duration_sec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "hook": {
                    "type": "object",
                    "properties": {
                      "amber_word": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "end_card_v2": {
                    "type": "boolean"
                  },
                  "title": {
                    "type": "string"
                  },
                  "subtitle": {
                    "type": "string"
                  },
                  "hit_on_start": {
                    "type": "boolean"
                  }
                },
                "required": ["target_duration_sec"],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "sound_design": {
              "type": "object",
              "properties": {
                "hum": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gain_db": {
                      "type": "number"
                    }
                  },
                  "required": ["key"],
                  "additionalProperties": false
                },
                "bed": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gain_db": {
                      "type": "number"
                    },
                    "start_scene": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "end_scene": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fade_in_sec": {
                      "type": "number"
                    },
                    "resume_gain_db": {
                      "type": "number"
                    },
                    "resume_fade_in_sec": {
                      "type": "number"
                    }
                  },
                  "required": ["key", "start_scene"],
                  "additionalProperties": false
                },
                "heartbeat": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gain_db": {
                      "type": "number"
                    },
                    "start_scene": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "start_offset_sec": {
                      "type": "number"
                    },
                    "end_scene": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "fade_in_sec": {
                      "type": "number"
                    }
                  },
                  "required": ["key", "start_scene", "end_scene"],
                  "additionalProperties": false
                },
                "hit": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gain_db": {
                      "type": "number"
                    }
                  },
                  "required": ["key"],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["output", "scenes"],
          "additionalProperties": false
        },
        "compilation": {
          "type": "object",
          "properties": {
            "episodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["ref", "title"],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": ["episodes"],
          "additionalProperties": false
        },
        "carousel": {
          "type": "object",
          "properties": {
            "slides": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "headline": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {
                    "type": "string"
                  },
                  "showFolder": {
                    "type": "boolean"
                  }
                },
                "required": ["headline"],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "postCaption": {
              "type": "string",
              "minLength": 1
            },
            "watermarkImage": {
              "type": "string"
            }
          },
          "required": ["slides", "postCaption"],
          "additionalProperties": false
        }
      },
      "required": ["version", "projectRef", "template", "visual", "outputs"],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
