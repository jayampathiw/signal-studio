{
  "name": "signal-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "evals": "node evals/run.js",
    "bootstrap": "node scripts/bootstrap.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/typecheck.mjs",
    "grep-guard": "node scripts/grep-guard.mjs",
    "examples": "node scripts/run-examples.mjs",
    "test": "vitest run && pnpm --filter '!dashboard' -r --if-present run test && node --experimental-strip-types --test 'scripts/golden/*.test.ts'",
    "golden:ffmpeg": "node scripts/golden/verify-references.mjs underdog-longform underdog-short",
    "golden:remotion": "node scripts/golden/verify-references.mjs policy-file-16x9 policy-file-9x16 pilot-clips-overlay-fb pilot-clips-overlay-ig"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
