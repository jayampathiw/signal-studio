{
  "name": "signal-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/video",
    "apps/dashboard",
    "projects/assemblex-factory/pilot",
    "packages/ai",
    "packages/render/core",
    "packages/render/ffmpeg",
    "packages/render/remotion",
    "packages/media",
    "packages/database",
    "packages/publishers",
    "packages/config",
    "packages/types",
    "packages/shared",
    "packages/core",
    "packages/db",
    "packages/providers"
  ],
  "scripts": {
    "video": "node apps/video/src/pipeline.js",
    "evals": "node evals/run.js",
    "bootstrap": "node scripts/bootstrap.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run && pnpm --filter '!dashboard' -r --if-present run test && node --experimental-strip-types --test scripts/golden/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
